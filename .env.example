# Biddr environment variables. Copy to .env.local for local development and set the
# same names in Vercel → Settings → Environment Variables. Placeholders only: never
# commit real keys. Server-only variables (no NEXT_PUBLIC_ prefix) never reach the browser.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://biddr.example
# Shared secret for the scheduled jobs (pg_cron → /api/...); the same value goes in the Supabase Vault as biddr_cron_secret.
CRON_SECRET=a-long-random-string

# Stripe (test keys start with pk_test_ / sk_test_). The webhook secret is from the
# webhook destination in the Stripe dashboard (payment and Identity events).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
BID_HOLD_AMOUNT_EUR=500

# Fake-listing checks (DECISIONS.md point 16). Without ANTHROPIC_API_KEY the checks
# don't run and every listing needs an admin's override; without GOOGLE_VISION_API_KEY
# the reverse image search is skipped.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: the model that reads the photos and documents (default claude-sonnet-5-5;
# low-confidence values are read once more with claude-opus-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key

# Emails (optional; nothing is sent until SMTP_HOST and EMAIL_FROM are set)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Admin demo data tools: keep false in production.
ENABLE_DEMO_DATA=false
